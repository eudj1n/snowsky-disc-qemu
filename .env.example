# Copy to .env, set OTA_DIR, then run ./run.sh up && ./run.sh boot.
# Compose reads this file; run.sh up updates OTA_DIR and preserves other entries.
# Shell environment variables override values in this file for Compose commands.

# Empty uses the reviewed default from firmware/active-version.
# Set an explicit version to pin this installation to a reviewed profile.
# OTA_DIR must point to the selected version's main_os/ota_vNNN chunk directory,
# not the ZIP or its outer folder. See firmware/README.md.
FW_VERSION=
OTA_DIR=/absolute/path/to/SNOWSKY_DISC_update_.../main_os/ota_v257

# Host media directory. Setup rebuilds the emulated FAT image from these files.
SD_DIR=./emulator/sdcard

# Persistent Docker volume: extracted firmware, settings, library and capture.
# Set WORK_VOLUME explicitly to reuse an existing volume. For a DIFFERENT firmware use
# a NEW volume, e.g. snowsky-disc-work-v257; changing FW_VERSION does not migrate rootfs.
# To keep an existing V2.40 volume, set FW_VERSION=2.40 and its matching OTA_DIR.
WORK_VOLUME=snowsky-disc-work

# Setup language (stock index): 0 zh, 1 tw, 2 en, 3 ja, 4 ko, 5 es,
# 6 it, 7 de, 8 pt, 9 ru. Setup applies this value and skips the language wizard.
LANG_CODE=2

# Maximum guest lifetime in seconds. Boot sets the guest deadline;
# changing this requires recreating the container and restarting the guest.
GUEST_TTL=1800

# Viewer capture rate; unchanged frames are suppressed without lossy encoding.
STREAM_FPS=12
# Optional viewer Power-on script, absolute path INSIDE the container.
# Empty uses /repo/emulator/scripts/20_boot.sh. Does not change ./run.sh boot.
DEVICE_BOOT_SCRIPT=
# Optional WebSocket bridge. Leave disabled for the normal viewer/TCP setup.
# Alternatively: docker compose --profile wsbridge up -d wsbridge
# COMPOSE_PROFILES=wsbridge

# Advanced Compose overrides. run.sh expects container name snowsky-disc-qemu;
# use docker compose exec emu ... directly if you choose a different name.
# EMU_IMAGE=snowsky-disc-qemu
# EMU_CONTAINER_NAME=snowsky-disc-qemu

# Apply changed container environment/mounts: ./run.sh up, then ./run.sh boot.
# Guest SYSCONFIG settings are separate; see docs/SETTINGS.md.
# Do not put firmware download URLs or GitHub tokens in this file.
