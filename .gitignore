# Firmware and anything derived from it — NEVER commit (copyrighted; download per firmware/README.md)
*.enc
*.squashfs
rootfs/
work/
/ota/

# FiiO binaries / assets that might get copied around during RE
mq_ui
mq_player
*.gpr
*.rep/
ghidra_proj*/
*.gzf

# Runtime captures (throwaway; curated shots live in docs/images/)
shots/
*.snap
*.bin
fb0*
*.log

# Build artifacts
*.so
*.o
a.out

# OS cruft
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc

# Local compose env (machine-specific OTA path)
.env

# SD card drop folder: keep the folder + docs, ignore the media the user drops in
/sdcard/*
!/sdcard/.gitkeep
!/sdcard/README.md

# JetBrains IDE
.idea/
*.iml
